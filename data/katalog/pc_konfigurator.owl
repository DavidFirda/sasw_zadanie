<owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/source"/>

<owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>

<owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>

<owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>

<owl:Class rdf:about="#Komponent">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label xml:lang="sk">Komponent</rdfs:label>
  <rdfs:label xml:lang="en">Component</rdfs:label>
  <rdfs:comment xml:lang="sk">Akykolvek hardverovy diel, z ktoreho sa sklada PC zostava.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Procesor">
  <rdfs:subClassOf rdf:resource="#Komponent"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#podporujeTypPamate"/>
      <owl:someValuesFrom rdf:resource="#TypPamate"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#maSocket"/>
      <owl:onClass rdf:resource="#Socket"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#vyrobil"/>
      <owl:someValuesFrom rdf:resource="#Vyrobca"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label xml:lang="en">Processor</rdfs:label>
  <rdfs:label xml:lang="sk">Procesor (CPU)</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ZakladnaDoska">
  <rdfs:subClassOf rdf:resource="#Komponent"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#podporujeTypPamate"/>
      <owl:someValuesFrom rdf:resource="#TypPamate"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#maFormFaktorDosky"/>
      <owl:onClass rdf:resource="#FormFaktorDosky"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#maCipset"/>
      <owl:someValuesFrom rdf:resource="#Cipset"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#podporujeSocket"/>
      <owl:onClass rdf:resource="#Socket"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label xml:lang="sk">Základná doska</rdfs:label>
  <rdfs:label xml:lang="en">Motherboard</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#OperacnaPamat">
  <rdfs:subClassOf rdf:resource="#Komponent"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#maTypPamate"/>
      <owl:onClass rdf:resource="#TypPamate"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label xml:lang="sk">Operačná pamäť (RAM)</rdfs:label>
  <rdfs:label xml:lang="en">Memory</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#GrafickaKarta">
  <rdfs:subClassOf rdf:resource="#Komponent"/>
