<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.example.org/pc-konfigurator"
         xmlns="http://www.example.org/pc-konfigurator#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#"
         xmlns:term="http://purl.org/dc/terms/">

<owl:Ontology rdf:about="http://www.example.org/pc-konfigurator">
  <term:title xml:lang="sk">Ontológia PC konfigurátora</term:title>
  <rdfs:comment xml:lang="sk">Ontológia popisuje komponenty osobného počítača, ich technické parametre a pravidlá kompatibility (socket, typ pamäte, form faktor, rozmery, výkon zdroja). Súčasťou sú vzorové zostavy a SWRL pravidlá, z ktorých reasoner (Pellet) odvodzuje kompatibilitu a problémy. Pravidlá so swrlb: built-ins HermiT nepodporuje.</rdfs:comment>
  <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2.0 (2026-09-23) – 52 komponentov, 6 skríň, 12 bezchybných zostáv + 3 testovacie</owl:versionInfo>
</owl:Ontology>

<owl:ObjectProperty rdf:about="#vyrobil">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Komponent"/>
  <rdfs:range rdf:resource="#Vyrobca"/>
  <rdfs:label xml:lang="en">manufactured by</rdfs:label>
  <rdfs:label xml:lang="sk">vyrobil</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#maSocket">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Procesor"/>
  <rdfs:range rdf:resource="#Socket"/>
  <rdfs:label xml:lang="sk">má socket</rdfs:label>
  <rdfs:label xml:lang="en">has socket</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#podporujeSocket">
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#ZakladnaDoska"/>
        <rdf:Description rdf:about="#Chladic"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range rdf:resource="#Socket"/>
  <rdfs:label xml:lang="sk">podporuje socket</rdfs:label>
  <rdfs:label xml:lang="en">supports socket</rdfs:label>
  <rdfs:comment xml:lang="sk">Doska má práve jeden socket, chladič môže podporovať viac socketov.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#maCipset">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ZakladnaDoska"/>
  <rdfs:range rdf:resource="#Cipset"/>
  <rdfs:label xml:lang="sk">má čipset</rdfs:label>
  <rdfs:label xml:lang="en">has chipset</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#podporujeTypPamate">
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Procesor"/>
        <rdf:Description rdf:about="#ZakladnaDoska"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range rdf:resource="#TypPamate"/>
  <rdfs:label xml:lang="en">supports memory type</rdfs:label>
  <rdfs:label xml:lang="sk">podporuje typ pamäte</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#maTypPamate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#OperacnaPamat"/>
  <rdfs:range rdf:resource="#TypPamate"/>
  <rdfs:label xml:lang="sk">má typ pamäte</rdfs:label>
  <rdfs:label xml:lang="en">has memory type</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#maFormFaktorDosky">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ZakladnaDoska"/>
  <rdfs:range rdf:resource="#FormFaktorDosky"/>
  <rdfs:label xml:lang="en">has form factor</rdfs:label>
  <rdfs:label xml:lang="sk">má form faktor</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#podporujeFormFaktorDosky">
  <rdfs:domain rdf:resource="#Skrinka"/>
  <rdfs:range rdf:resource="#FormFaktorDosky"/>
  <rdfs:label xml:lang="sk">podporuje form faktor dosky</rdfs:label>
  <rdfs:label xml:lang="en">supports motherboard form factor</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#maFormFaktorZdroja">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Zdroj"/>
  <rdfs:range rdf:resource="#FormFaktorZdroja"/>
  <rdfs:label xml:lang="sk">má form faktor zdroja</rdfs:label>
  <rdfs:label xml:lang="en">has PSU form factor</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#podporujeFormFaktorZdroja">
  <rdfs:domain rdf:resource="#Skrinka"/>
  <rdfs:range rdf:resource="#FormFaktorZdroja"/>
  <rdfs:label xml:lang="sk">podporuje form faktor zdroja</rdfs:label>
  <rdfs:label xml:lang="en">supports PSU form factor</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#maRozhranie">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Ulozisko"/>
  <rdfs:range rdf:resource="#RozhranieUloziska"/>
  <rdfs:label xml:lang="en">has interface</rdfs:label>
  <rdfs:label xml:lang="sk">má rozhranie</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#podporujeRozhranie">
  <rdfs:domain rdf:resource="#ZakladnaDoska"/>
  <rdfs:range rdf:resource="#RozhranieUloziska"/>
  <rdfs:label xml:lang="en">supports interface</rdfs:label>
  <rdfs:label xml:lang="sk">podporuje rozhranie</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#obsahujeKomponent">
  <rdfs:domain rdf:resource="#Zostava"/>
  <rdfs:range rdf:resource="#Komponent"/>
  <owl:inverseOf rdf:resource="#jeSucastouZostavy"/>
  <rdfs:label xml:lang="en">contains component</rdfs:label>
  <rdfs:label xml:lang="sk">obsahuje komponent</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#jeSucastouZostavy">
  <rdfs:domain rdf:resource="#Komponent"/>
  <rdfs:range rdf:resource="#Zostava"/>
  <owl:inverseOf rdf:resource="#obsahujeKomponent"/>
  <rdfs:label xml:lang="sk">je súčasťou zostavy</rdfs:label>
  <rdfs:label xml:lang="en">is part of build</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#maProcesor">
  <rdfs:subPropertyOf rdf:resource="#obsahujeKomponent"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Zostava"/>
  <rdfs:range rdf:resource="#Procesor"/>
  <rdfs:label xml:lang="en">has CPU</rdfs:label>
  <rdfs:label xml:lang="sk">má procesor</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#maDosku">
  <rdfs:subPropertyOf rdf:resource="#obsahujeKomponent"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Zostava"/>
  <rdfs:range rdf:resource="#ZakladnaDoska"/>
  <rdfs:label xml:lang="sk">má dosku</rdfs:label>
  <rdfs:label xml:lang="en">has motherboard</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#maGrafiku">
  <rdfs:subPropertyOf rdf:resource="#obsahujeKomponent"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Zostava"/>
  <rdfs:range rdf:resource="#GrafickaKarta"/>
  <rdfs:label xml:lang="en">has GPU</rdfs:label>
  <rdfs:label xml:lang="sk">má grafiku</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#maZdroj">
  <rdfs:subPropertyOf rdf:resource="#obsahujeKomponent"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Zostava"/>
  <rdfs:range rdf:resource="#Zdroj"/>
  <rdfs:label xml:lang="en">has PSU</rdfs:label>
  <rdfs:label xml:lang="sk">má zdroj</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#maSkrinku">
  <rdfs:subPropertyOf rdf:resource="#obsahujeKomponent"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Zostava"/>
  <rdfs:range rdf:resource="#Skrinka"/>
  <rdfs:label xml:lang="sk">má skrinku</rdfs:label>
  <rdfs:label xml:lang="en">has case</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#maChladic">
  <rdfs:subPropertyOf rdf:resource="#obsahujeKomponent"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Zostava"/>
  <rdfs:range rdf:resource="#Chladic"/>
  <rdfs:label xml:lang="sk">má chladič</rdfs:label>
  <rdfs:label xml:lang="en">has cooler</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#maPamat">
  <rdfs:subPropertyOf rdf:resource="#obsahujeKomponent"/>
  <rdfs:domain rdf:resource="#Zostava"/>
  <rdfs:range rdf:resource="#OperacnaPamat"/>
  <rdfs:label xml:lang="en">has memory</rdfs:label>
  <rdfs:label xml:lang="sk">má pamäť</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#maUlozisko">
  <rdfs:subPropertyOf rdf:resource="#obsahujeKomponent"/>
  <rdfs:domain rdf:resource="#Zostava"/>
  <rdfs:range rdf:resource="#Ulozisko"/>
  <rdfs:label xml:lang="sk">má úložisko</rdfs:label>
  <rdfs:label xml:lang="en">has storage</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#vhodnaPre">
  <rdfs:domain rdf:resource="#Zostava"/>
  <rdfs:range rdf:resource="#UcelPouzitia"/>
  <rdfs:label xml:lang="sk">vhodná pre</rdfs:label>
  <rdfs:label xml:lang="en">suitable for</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#maProblem">
  <rdfs:domain rdf:resource="#Zostava"/>
  <rdfs:range rdf:resource="#TypProblemu"/>
  <rdfs:label xml:lang="sk">má problém</rdfs:label>
  <rdfs:label xml:lang="en">has issue</rdfs:label>
  <rdfs:comment xml:lang="sk">Odvodzuje ho reasoner cez SWRL pravidlá.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#jeKompatibilnySo">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:domain rdf:resource="#Komponent"/>
  <rdfs:range rdf:resource="#Komponent"/>
  <rdfs:label xml:lang="en">is compatible with</rdfs:label>
  <rdfs:label xml:lang="sk">je kompatibilný so</rdfs:label>
  <rdfs:comment xml:lang="sk">Nadvlastnosť všetkých pozitívnych vzťahov kompatibility. Hodnoty odvodzuje reasoner zo SWRL pravidiel.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#jeNekompatibilnySo">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:domain rdf:resource="#Komponent"/>
  <rdfs:range rdf:resource="#Komponent"/>
  <rdfs:label xml:lang="en">is incompatible with</rdfs:label>
  <rdfs:label xml:lang="sk">je nekompatibilný so</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#procesorPasujeNaDosku">
  <rdfs:subPropertyOf rdf:resource="#jeKompatibilnySo"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:label xml:lang="sk">procesor pasuje na dosku (socket)</rdfs:label>
  <rdfs:label xml:lang="en">CPU fits motherboard</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#pamatPasujeDoDosky">
  <rdfs:subPropertyOf rdf:resource="#jeKompatibilnySo"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:label xml:lang="sk">pamäť pasuje do dosky (typ RAM)</rdfs:label>
  <rdfs:label xml:lang="en">RAM fits motherboard</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#doskaSaZmestiDo">
  <rdfs:subPropertyOf rdf:resource="#jeKompatibilnySo"/>
  <rdfs:label xml:lang="sk">doska sa zmestí do skrinky</rdfs:label>
  <rdfs:label xml:lang="en">board fits case</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#grafikaSaZmestiDo">
  <rdfs:subPropertyOf rdf:resource="#jeKompatibilnySo"/>
  <rdfs:label xml:lang="en">GPU fits case</rdfs:label>
  <rdfs:label xml:lang="sk">grafika sa zmestí do skrinky</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#chladicSaZmestiDo">
  <rdfs:subPropertyOf rdf:resource="#jeKompatibilnySo"/>
  <rdfs:label xml:lang="en">cooler fits case</rdfs:label>
  <rdfs:label xml:lang="sk">chladič sa zmestí do skrinky</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#chladicPasujeNaProcesor">
  <rdfs:subPropertyOf rdf:resource="#jeKompatibilnySo"/>
  <rdfs:label xml:lang="sk">chladič pasuje na procesor (socket)</rdfs:label>
  <rdfs:label xml:lang="en">cooler fits CPU</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#zdrojSaZmestiDo">
  <rdfs:subPropertyOf rdf:resource="#jeKompatibilnySo"/>
  <rdfs:label xml:lang="en">PSU fits case</rdfs:label>
  <rdfs:label xml:lang="sk">zdroj sa zmestí do skrinky</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#zdrojStaciPre">
  <rdfs:subPropertyOf rdf:resource="#jeKompatibilnySo"/>
  <rdfs:label xml:lang="sk">zdroj stačí pre grafiku</rdfs:label>
  <rdfs:label xml:lang="en">PSU sufficient for GPU</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#procesorNepasujeNaDosku">
  <rdfs:subPropertyOf rdf:resource="#jeNekompatibilnySo"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:label xml:lang="en">CPU does not fit board</rdfs:label>
  <rdfs:label xml:lang="sk">procesor nepasuje na dosku</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#pamatNepasujeDoDosky">
  <rdfs:subPropertyOf rdf:resource="#jeNekompatibilnySo"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:label xml:lang="en">RAM does not fit board</rdfs:label>
  <rdfs:label xml:lang="sk">pamäť nepasuje do dosky</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#grafikaSaNezmestiDo">
  <rdfs:subPropertyOf rdf:resource="#jeNekompatibilnySo"/>
  <rdfs:label xml:lang="en">GPU too long for case</rdfs:label>
  <rdfs:label xml:lang="sk">grafika sa nezmestí do skrinky</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#chladicSaNezmestiDo">
  <rdfs:subPropertyOf rdf:resource="#jeNekompatibilnySo"/>
  <rdfs:label xml:lang="en">cooler too tall for case</rdfs:label>
  <rdfs:label xml:lang="sk">chladič sa nezmestí do skrinky</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#zdrojNestaciPre">
  <rdfs:subPropertyOf rdf:resource="#jeNekompatibilnySo"/>
  <rdfs:label xml:lang="sk">zdroj nestačí pre grafiku</rdfs:label>
  <rdfs:label xml:lang="en">PSU too weak for GPU</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#radiatorSaZmestiDo">
  <rdfs:subPropertyOf rdf:resource="#jeKompatibilnySo"/>
  <rdfs:label xml:lang="en">radiator fits case</rdfs:label>
  <rdfs:label xml:lang="sk">radiátor sa zmestí do skrinky</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#radiatorSaNezmestiDo">
  <rdfs:subPropertyOf rdf:resource="#jeNekompatibilnySo"/>
  <rdfs:label xml:lang="en">radiator does not fit case</rdfs:label>
  <rdfs:label xml:lang="sk">radiátor sa nezmestí do skrinky</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#chladicNestaciPre">
  <rdfs:subPropertyOf rdf:resource="#jeNekompatibilnySo"/>
  <rdfs:label xml:lang="sk">chladič nestačí na TDP procesora</rdfs:label>
  <rdfs:label xml:lang="en">cooler insufficient for CPU TDP</rdfs:label>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#nazov">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Komponent"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label xml:lang="en">name</rdfs:label>
  <rdfs:label xml:lang="sk">názov</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#msrpUSD">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Komponent"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label xml:lang="sk">odporúčaná cena výrobcu (USD)</rdfs:label>
  <rdfs:label xml:lang="en">MSRP (USD)</rdfs:label>
  <rdfs:comment xml:lang="sk">Oficiálna uvádzacia cena. Aktuálne ceny v EUR sa menia, preto ich do ontológie nevkladáme natvrdo.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#pocetJadier">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Procesor"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:label xml:lang="sk">počet jadier</rdfs:label>
  <rdfs:label xml:lang="en">core count</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#pocetVlakien">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Procesor"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:label xml:lang="sk">počet vlákien</rdfs:label>
  <rdfs:label xml:lang="en">thread count</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#zakladnaFrekvenciaGHz">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Procesor"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label xml:lang="sk">základná frekvencia (GHz)</rdfs:label>
  <rdfs:label xml:lang="en">base clock (GHz)</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#boostFrekvenciaGHz">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Procesor"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label xml:lang="en">boost clock (GHz)</rdfs:label>
  <rdfs:label xml:lang="sk">boost frekvencia (GHz)</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#tdpW">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Procesor"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
