<owl:Class rdf:about="#HDD">
  <rdfs:subClassOf rdf:resource="#Ulozisko"/>
  <rdfs:label xml:lang="sk">Pevný disk (HDD)</rdfs:label>
  <rdfs:label xml:lang="en">Hard disk drive</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Zdroj">
  <rdfs:subClassOf rdf:resource="#Komponent"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#maFormFaktorZdroja"/>
      <owl:onClass rdf:resource="#FormFaktorZdroja"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label xml:lang="en">Power supply</rdfs:label>
  <rdfs:label xml:lang="sk">Zdroj (PSU)</rdfs:label>
