          <owl:hasValue rdf:resource="#SFX"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#maxDlzkaGPUmm"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
