  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#podporujeFormFaktorZdroja"/>
      <owl:someValuesFrom rdf:resource="#FormFaktorZdroja"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#podporujeFormFaktorDosky"/>
      <owl:someValuesFrom rdf:resource="#FormFaktorDosky"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label xml:lang="sk">Skrinka (case)</rdfs:label>
  <rdfs:label xml:lang="en">Case</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Chladic">
  <rdfs:subClassOf rdf:resource="#Komponent"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#podporujeSocket"/>
      <owl:someValuesFrom rdf:resource="#Socket"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label xml:lang="en">CPU cooler</rdfs:label>
  <rdfs:label xml:lang="sk">Chladič procesora</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#VzduchovyChladic">
  <rdfs:subClassOf rdf:resource="#Chladic"/>
  <owl:disjointWith rdf:resource="#VodnyChladicAIO"/>
  <rdfs:label xml:lang="en">Air cooler</rdfs:label>
  <rdfs:label xml:lang="sk">Vzduchový chladič</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#VodnyChladicAIO">
  <rdfs:subClassOf rdf:resource="#Chladic"/>
