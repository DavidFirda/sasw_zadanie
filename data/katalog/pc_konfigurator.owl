</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#maRGB">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#OperacnaPamat"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  <rdfs:label xml:lang="en">has RGB</rdfs:label>
  <rdfs:label xml:lang="sk">má RGB podsvietenie</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#cenaEur">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Komponent"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
