</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#celkovaCenaEur">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Zostava"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label xml:lang="sk">celková orientačná cena (EUR)</rdfs:label>
  <rdfs:label xml:lang="en">total indicative price (EUR)</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#cenovaKategoria">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Zostava"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
