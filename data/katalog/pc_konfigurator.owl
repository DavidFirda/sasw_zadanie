  <rdfs:label xml:lang="en">TDP (W)</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#maxTurboPrikonW">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Procesor"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:label xml:lang="en">max turbo power (W)</rdfs:label>
  <rdfs:label xml:lang="sk">max. turbo príkon (W)</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#l3CacheMB">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Procesor"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:label xml:lang="sk">L3 cache (MB)</rdfs:label>
  <rdfs:label xml:lang="en">L3 cache (MB)</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#maIntegrovanuGrafiku">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Procesor"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  <rdfs:label xml:lang="en">has integrated graphics</rdfs:label>
  <rdfs:label xml:lang="sk">má integrovanú grafiku</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#vramGB">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#GrafickaKarta"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:label xml:lang="sk">VRAM (GB)</rdfs:label>
  <rdfs:label xml:lang="en">VRAM (GB)</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#typVRAM">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#GrafickaKarta"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
